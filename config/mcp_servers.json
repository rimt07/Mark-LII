{
  "_comment": "MCP Server Configuration - Official Anthropic MCP filesystem server",
  "servers": {
    "fs": {
      "name": "MCP Filesystem Server",
      "description": "Official Anthropic filesystem server for local file access",
      "enabled": true,
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:/dev/"
      ],
      "restart_on_failure": true,
      "health_check_interval": 60
    }
  },
  "settings": {
    "namespace_pattern": "{server}_{tool}",
    "log_level": "INFO",
    "startup_timeout": 30,
    "tool_timeout": 60
  }
}
